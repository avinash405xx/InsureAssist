# Public frontend configuration
VITE_BRAND_NAME=Your Brand Name
VITE_BRAND_TAGLINE=Insurance + ongoing support
VITE_LEAD_ENDPOINT=/api/leads
VITE_CLAIM_ENDPOINT=/api/claims
VITE_VEHICLE_LOOKUP_ENDPOINT=/api/vehicle-lookup
VITE_META_PIXEL_ID=
VITE_CLARITY_PROJECT_ID=

# Server-only Vercel variables (NEVER prefix with VITE_)
GOOGLE_APPS_SCRIPT_URL=
API_SATHI_KEY=

# Optional: comma-separated insurer/provider names you are actually authorized to distribute.
# Do not add a brand unless you have the right to represent/display it.
VITE_AUTHORIZED_PROVIDER_NAMES=
# Optional richer provider config: [{"name":"Bajaj General","logo":"/provider-logos/bajaj-general.svg"}]
VITE_AUTHORIZED_PROVIDERS_JSON=[]

# Footer / legal configuration (rendered in the footer ONLY when set — leave blank to hide).
# Never invent these values: fill them from your actual business registration / channel agreement.
VITE_LEGAL_BUSINESS_NAME=
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_BUSINESS_ADDRESS=
VITE_AUTHORIZATION_TEXT=
VITE_PRIVACY_URL=
VITE_TERMS_URL=
